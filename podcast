#!/usr/bin/env bash
# VoxForge Studio — Single-Command Autonomous Podcast Video Producer
# Usage:
#   ./podcast "build a 1 hour long podcast on 7 wonders of the world"
#   ./podcast studio --port 8000

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="${SCRIPT_DIR}/.venv"

if [ ! -x "${VENV_DIR}/bin/python" ]; then
    echo "[VoxForge Bootstrap] Creating isolated Python studio environment (.venv)..."
    python3 -m venv "${VENV_DIR}"
    "${VENV_DIR}/bin/pip" install --upgrade pip -q
    "${VENV_DIR}/bin/pip" install -r "${SCRIPT_DIR}/requirements.txt" -q
    "${VENV_DIR}/bin/pip" install -e "${SCRIPT_DIR}" --no-deps -q
elif ! "${VENV_DIR}/bin/python" -c "import cv2, onnxruntime, kaldi_native_fbank" >/dev/null 2>&1; then
    echo "[VoxForge Bootstrap] Syncing neural studio video dependencies..."
    "${VENV_DIR}/bin/pip" install -r "${SCRIPT_DIR}/requirements.txt" -q
fi

export PYTHONPATH="${SCRIPT_DIR}:${PYTHONPATH:-}"
exec "${VENV_DIR}/bin/python" -m voxforge.cli "$@"
